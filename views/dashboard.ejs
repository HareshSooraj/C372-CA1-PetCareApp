<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet-Care Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include ('partials/navbar') %>

  <main class="container mt-5 mb-5">
    <h2 class="mb-4">My Pet-Care Dashboard</h2>

    <div class="row g-3 mb-4">
      <div class="col-12 col-sm-6 col-lg-3"><div class="card h-100 text-bg-primary"><div class="card-body"><div class="small">My Pets</div><div class="display-6"><%= summary.pet_count %></div></div></div></div>
      <div class="col-12 col-sm-6 col-lg-3"><div class="card h-100 text-bg-success"><div class="card-body"><div class="small">Journal Entries</div><div class="display-6"><%= summary.journal_count %></div></div></div></div>
      <div class="col-12 col-sm-6 col-lg-3"><div class="card h-100 text-bg-warning"><div class="card-body"><div class="small">Upcoming Bookings</div><div class="display-6"><%= summary.upcoming_booking_count %></div></div></div></div>
      <div class="col-12 col-sm-6 col-lg-3"><div class="card h-100 text-bg-secondary"><div class="card-body"><div class="small">Pending Payments</div><div class="display-6"><%= summary.pending_payment_count %></div></div></div></div>
    </div>

    <div class="row g-4">
      <section class="col-12 col-lg-6">
        <div class="card h-100"><div class="card-header">Recent Journal Activity</div><div class="card-body">
          <% if (recentJournals.length === 0) { %><p class="text-muted mb-0">No journal entries yet.</p><% } else { %>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Pet</th><th>Activity</th><th>Date</th></tr></thead><tbody>
              <% recentJournals.forEach((journal) => { %><tr><td><%= journal.pet_name %></td><td><%= journal.activity %></td><td><%= journal.entry_date %></td></tr><% }) %>
            </tbody></table></div>
          <% } %>
        </div></div>
      </section>
      <section class="col-12 col-lg-6">
        <div class="card h-100"><div class="card-header">Upcoming Service Bookings</div><div class="card-body">
          <% if (upcomingBookings.length === 0) { %><p class="text-muted mb-0">No upcoming pending bookings.</p><% } else { %>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Pet</th><th>Service</th><th>Date</th><th>Status</th></tr></thead><tbody>
              <% upcomingBookings.forEach((booking) => { %><tr><td><%= booking.pet_name %></td><td><%= booking.service_name %></td><td><%= booking.booking_date %></td><td><%= booking.booking_status %></td></tr><% }) %>
            </tbody></table></div>
          <% } %>
        </div></div>
      </section>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
      <a class="btn btn-primary" href="/journals">My Pets / Journals</a>
      <a class="btn btn-outline-primary" href="/services">Services</a>
      <a class="btn btn-outline-primary" href="/bookings">Booking History</a>
    </div>
  </main>
</body>
</html>
