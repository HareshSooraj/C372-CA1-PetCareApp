<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Journals</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <%- include ('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Pet Care Journals</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger" role="alert"><%= errors[0] %></div>
    <% } %>

    <form action="/journals/search" method="GET" class="mb-3 d-flex">
        <input type="text" name="q" class="form-control me-2" placeholder="Search activity or notes..." required>
        <% if (selectedPetId) { %>
            <input type="hidden" name="petId" value="<%= selectedPetId %>">
        <% } %>
        <button type="submit" class="btn btn-outline-primary me-2">Search</button>
        <% let resetUrl = '/journals'; %>
        <% if (selectedPetId) { %>
        <% resetUrl += '?petId=' + selectedPetId; %>
        <% } %>
        <a href="<%= resetUrl %>" class="btn btn-outline-secondary">Reset</a>
    </form>

    <% if (pets && pets.length > 0) { %>
        <form method="GET" action="/journals" class="mb-3">
            <% if (startDate) { %>
                <input type="hidden" name="startDate" value="<%= startDate %>">
            <% } %>
            <% if (endDate) { %>
                <input type="hidden" name="endDate" value="<%= endDate %>">
            <% } %>
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                <label for="petId" class="col-form-label">Select Pet:</label>
                </div>
                <div class="col-auto">
                <select name="petId" id="petId" class="form-select" onchange="this.form.submit()">
                    <option value="" <%= !selectedPetId ? 'selected' : '' %>>-- All Pets --</option>
                    <% for (let i = 0; i < pets.length; i++) { %>
                    <% if (selectedPetId && selectedPetId == pets[i].id.toString()) { %>
                        <option value="<%= pets[i].id %>" selected><%= pets[i].name %></option>
                    <% } else { %>
                        <option value="<%= pets[i].id %>"><%= pets[i].name %></option>
                    <% } %>
                    <% } %>
                </select>
                </div>
            </div>
        </form>

        <form method="GET" action="/journals" class="mb-3">
            <% if (selectedPetId) { %>
              <input type="hidden" name="petId" value="<%= selectedPetId %>">
            <% } %>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control" id="startDate" name="startDate" value="<%= startDate || '' %>">
                </div>
                <div class="col-md-3">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" class="form-control" id="endDate" name="endDate" value="<%= endDate || '' %>">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">Filter Dates</button>
                    <% let clearFiltersUrl = '/journals'; %>
                    <% if (selectedPetId) { %>
                    <% clearFiltersUrl += '?petId=' + selectedPetId; %>
                    <% } %>
                    <a href="<%= clearFiltersUrl %>" class="btn btn-outline-secondary">Clear Filters</a>
                </div>
            </div>
        </form>
    <% } %>



    <% if (pet && pet.name) { %>
    <div class="card mb-4">
        <div class="card-header bg-dark text-white text-center">
            <strong>Pet Info</strong>
        </div>
        <div class="card-body d-flex flex-column align-items-center">
            <img src="/images/<%= pet.image %>" 
                class="img-thumbnail mb-3" 
                alt="<%= pet.image %>" 
                style="width: 200px; height: 200px; object-fit: cover;">

            <p><strong>Name:</strong> <%= pet.name %></p>
            <p><strong>Type:</strong> <%= pet.species %></p>
            <p><strong>Breed:</strong> <%= pet.breed %></p>
            <p><strong>Age:</strong> <%= pet.age %> years</p>
            <a href="/pets/<%= pet.id %>/edit" class="btn btn-outline-primary">Edit Pet</a>
        </div>
        </div>

    <% } %>

    <a href="/journals/new" class="btn btn-success mb-3">+ Add New Entry</a>
    <a href="/pets/new" class="btn btn-outline-secondary mb-3">+ Add New Pet</a>
    <% let exportUrl = '/journals/export'; %>
    <% const exportFilters = []; %>
    <% if (selectedPetId) exportFilters.push('petId=' + encodeURIComponent(selectedPetId)); %>
    <% if (startDate) exportFilters.push('startDate=' + encodeURIComponent(startDate)); %>
    <% if (endDate) exportFilters.push('endDate=' + encodeURIComponent(endDate)); %>
    <% if (exportFilters.length > 0) exportUrl += '?' + exportFilters.join('&'); %>
    <a href="<%= exportUrl %>" class="btn btn-outline-success mb-3">Export CSV</a>


    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Date</th>
          <th>Activity</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (journals.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center">No journal entries found.</td>
          </tr>
        <% } else { %>
          <% for (let i = 0; i < journals.length; i++) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td>
                <% if (journals[i].entry_date) { %>
                    <% const entryDate = journals[i].entry_date; %>
                    <% if (entryDate instanceof Date) { %>
                      <%= entryDate.getFullYear() + '-' + String(entryDate.getMonth() + 1).padStart(2, '0') + '-' + String(entryDate.getDate()).padStart(2, '0') %>
                    <% } else { %>
                      <%= entryDate %>
                    <% } %>
                <% } else { %>
                    N/A
                <% } %>
              </td>
              <td><%= journals[i].activity %></td>
              <td><%= journals[i].notes %></td>
              <td>
                <a href="/journals/edit/<%= journals[i].id %>" class="btn btn-sm btn-warning">Edit</a>
                <a href="/journals/delete/<%= journals[i].id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this entry?');">Delete</a>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
