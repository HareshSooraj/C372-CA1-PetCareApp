<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Pet Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mt-5" style="max-width: 720px;">
    <h2 class="mb-4">Edit Pet Profile</h2>
    <% if (errors && errors.length) { errors.forEach((error) => { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% }); } %>
    <% if (pet.image) { %>
      <img src="/images/<%= pet.image %>" class="img-thumbnail mb-3" alt="<%= pet.name %>" style="width: 200px; height: 200px; object-fit: cover;">
    <% } %>
    <form action="/pets/<%= pet.id %>/edit" method="POST" enctype="multipart/form-data">
      <div class="mb-3"><label class="form-label" for="pet_name">Pet Name:</label><input id="pet_name" type="text" class="form-control" name="pet_name" value="<%= pet.name %>" required></div>
      <div class="mb-3"><label class="form-label" for="species">Species:</label><input id="species" type="text" class="form-control" name="species" value="<%= pet.species %>" required></div>
      <div class="mb-3"><label class="form-label" for="breed">Breed:</label><input id="breed" type="text" class="form-control" name="breed" value="<%= pet.breed %>" required></div>
      <div class="mb-3"><label class="form-label" for="age">Age:</label><input id="age" type="number" class="form-control" name="age" min="0" max="255" value="<%= pet.age %>" required></div>
      <div class="mb-3"><label class="form-label" for="pet_image">Replace Pet Image (optional):</label><input id="pet_image" type="file" class="form-control" name="pet_image" accept="image/*"><div class="form-text">Leave blank to keep the existing image.</div></div>
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/journals?petId=<%= pet.id %>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</body>
</html>
