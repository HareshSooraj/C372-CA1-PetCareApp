<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Booking History</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body>
  <%- include('partials/navbar') %>
  <main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><h1 class="h2 mb-0">Booking History</h1><a href="/services" class="btn btn-primary">Book a Service</a></div>
    <% if (messages && messages.length) { messages.forEach((message) => { %><div class="alert alert-success" role="status"><%= message %></div><% }); } %>
    <% if (errors && errors.length) { errors.forEach((error) => { %><div class="alert alert-danger" role="alert"><%= error %></div><% }); } %>
    <% if (!bookings.length) { %>
      <div class="alert alert-info">You have no bookings yet.</div>
    <% } else { %>
      <div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead class="table-dark"><tr><th>Booking #</th><th>Date</th><th>Pet</th><th>Service</th><th>Price</th><th>Booking Status</th><th>Payment Status</th></tr></thead><tbody>
        <% bookings.forEach((booking) => { %><tr><td><%= booking.booking_id %></td><td><%= booking.booking_date %></td><td><%= booking.pet_name %></td><td><%= booking.service_name %></td><td>S$<%= Number(booking.booked_price).toFixed(2) %></td><td><span class="badge text-bg-secondary"><%= booking.booking_status %></span></td><td><% if (booking.payment_status) { %><span class="badge text-bg-secondary"><%= booking.payment_status %></span><% } else { %><span class="text-secondary">No payment record</span><% } %></td></tr><% }); %>
      </tbody></table></div>
      <p class="text-secondary">Payments are pending. No payment has been processed by this app.</p>
    <% } %>
  </main>
</body>
</html>
